# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Hubtel Payment Gateway
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ID=

# SMS Gateway Setup (e.g. Arkesel, Hubtel, Mnotify)
SMS_API_KEY=
SMS_SENDER_ID="CHEF APEDO"

# Vercel Cron Secret — secures GET /api/cron/expire-orders (15-min abandoned payment sweep)
# Generate with: node -e "require('crypto').randomBytes(32).toString('hex') |> console.log"
# Must be set in Vercel Dashboard > Settings > Environment Variables for production cron to work.
CRON_SECRET=

# Social Media & Contact Links (used in Footer and Contact page)
# Phone: include country code, e.g. +233240000000
NEXT_PUBLIC_BUSINESS_PHONE=
# WhatsApp: digits only, no +, e.g. 233240000000
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/chefapedofoods
NEXT_PUBLIC_TIKTOK_URL=https://tiktok.com/@chefapedofoods
NEXT_PUBLIC_SNAPCHAT_URL=https://snapchat.com/add/chefapedofoods

# Never commit the filled-in version of this file — see docs/RULES.md and docs/SECURITY.md.
